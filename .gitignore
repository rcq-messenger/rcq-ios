# ───────────────────────────────────────────────────────────────────
# RCQ iOS .gitignore
# ───────────────────────────────────────────────────────────────────
# Repository layout: `RCQ/` is the iOS client root. Backend + web-chat
# live in sibling dirs and are NOT in this repo (backend has hardcoded
# secrets, see README → "Why backend isn't here").

# ── macOS / Finder ────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# ── Xcode build outputs ───────────────────────────────────────────
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/

# Generated by xcodegen — committing it doubles diff noise on every
# project.yml change AND fights merges. Anyone cloning runs
# `xcodegen generate` once locally; the .xcodeproj is a build
# artifact, not source.
RCQ.xcodeproj/

# Swift Package Manager local state
.build/
.swiftpm/
Package.resolved.tmp

# ── Provisioning / signing artifacts ──────────────────────────────
# These never belong in source control. Most are pulled per-machine
# from Apple Developer Portal, not committed.
*.mobileprovision
*.provisionprofile
*.cer
*.p12
*.p8
*.certSigningRequest
ExportOptions.plist

# ── Vendored libsignal Rust build artifacts (5+ GB) ───────────────
# `Vendor/libsignal/` ships the SOURCE (Rust + Swift bindings) which
# IS committed so the repo builds offline. The `target/` folder is
# regenerated locally by `cargo build` — committing it would balloon
# the repo by gigabytes per platform slice.
RCQ/Vendor/libsignal/target/

# Also exclude common Rust per-machine state inside the vendored tree
RCQ/Vendor/libsignal/.cargo/config.toml.local
RCQ/Vendor/libsignal/Cargo.lock.local

# ── Prebuilt libsignal xcframework binaries ───────────────────────
# `libsignal_ffi.a` per-slice exceeds GitHub's 100MB single-file
# limit (~365MB device, ~388MB simulator). Excluded from the public
# repo — anyone cloning rebuilds them from the Rust source via
# `swift/build_ffi.sh`. See README "Building locally" → "Rebuilding
# libsignal" for the one-time setup. The .a files are deliberately
# considered build artifacts, not source — same posture as
# `target/` above.
RCQ/Vendor/libsignal/swift/libsignal_ffi.xcframework/*/libsignal_ffi.a
RCQ/Vendor/libsignal/swift/libsignal_ffi.xcframework/*-simulator/libsignal_ffi.a

# ── Prebuilt Rcqbox (sing-box transport) xcframework ──────────────
# gomobile-built binary; the simulator slice alone is ~101MB, past
# GitHub's 100MB single-file limit. Build artifact, not source —
# excluded with the same posture as the libsignal binaries above.
RCQ/Vendor/Rcqbox.xcframework/

# ── Secrets / local env ───────────────────────────────────────────
# Belt-and-suspenders against accidental commit. We deliberately
# don't HAVE any of these in iOS today (everything secret lives on
# the backend or in iOS Keychain at runtime), but keep the rules in
# case someone adds local debug overrides later.
.env
.env.*
secrets.*
*.secret
*_credentials.*

# ── Editor / OS scratch files ─────────────────────────────────────
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ── Misc ──────────────────────────────────────────────────────────
*.log
crash_*.log
*.bak
*.orig
