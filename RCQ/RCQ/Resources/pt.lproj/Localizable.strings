"radio.info.title" = "Sobre o Chat por rádio";
"radio.info.header.title" = "Chat local em malha";
"radio.info.header.subtitle" = "Fale com quem está por perto sem sinal de celular, sem internet por Wi-Fi, sem nenhum servidor nosso. As mensagens vão direto de um celular para o outro.";
"radio.info.what.title" = "O que é";
"radio.info.what.body" = "Uma camada de conversa offline que funciona sempre que os celulares estão fisicamente perto. Útil em festivais, shows, numa trilha, num estacionamento subterrâneo, durante uma queda de energia, ou em qualquer lugar onde a internet móvel esteja bloqueada, cara ou simplesmente ausente.";
"radio.info.how.title" = "Como funciona";
"radio.info.how.body" = "Seu iPhone encontra outros iPhones com o RCQ aberto por Bluetooth e pelo Wi-Fi ponto a ponto da Apple. Depois de pareados, as mensagens vão direto de aparelho para aparelho. Não precisa de chip, não precisa de antena de celular, nenhum servidor rcq.app entra no caminho.";
"radio.info.range.title" = "Alcance direto";
"radio.info.range.body" = "De celular para celular, conte com 30 a 100 metros em campo aberto e bem menos através de paredes. Um grupo de celulares pode retransmitir uns para os outros e esticar um pouco o alcance, mas trate 100 metros como o teto realista para dois aparelhos sozinhos.";
"radio.info.wifi.title" = "Truque para lugares grandes";
"radio.info.wifi.body" = "Se todo mundo estiver na mesma rede Wi-Fi (inclusive uma malha única que cobre um prédio ou um local inteiro), o Chat por rádio funciona em toda a área de cobertura do Wi-Fi, não só no raio de 100 metros ponto a ponto. Então num congresso, numa balada, num estádio ou num coworking, você alcança todo mundo no prédio.";
