"onboard.status.kicker" = "ESTADO";
"onboard.status.title" = "Elige tu estado";
"onboard.status.body" = "En línea, Ausente, No molestar, Invisible, Desconectado. Los cinco de siempre, y aquí significan algo. Toca el icono de tu estado para cambiarlo.";
"onboard.federation.kicker" = "FEDERACIÓN";
"onboard.federation.title" = "Sin un dueño único";
"onboard.federation.body" = "RCQ no es el servidor de una empresa. Cada servidor es una isla independiente y cualquiera puede montar una. Tu cuenta vive en la isla que elijas, y te llevas tu número si te mudas.";
"onboard.relay.kicker" = "PRIVACIDAD";
"onboard.relay.title" = "Relays de RCQ";
"onboard.relay.body" = "El tráfico no va directo a la isla, sino por nuestros relays: la isla no ve tu dirección, y la red entre tú y la isla no ve que usas RCQ. La red de relays la lleva la comunidad, y el enrutado onion los encadena para que ningún relay te vea a ti y a tu isla a la vez. Donde RCQ está bloqueado, además es el único camino.";
"onboard.chat.kicker" = "CHAT";
"onboard.chat.title" = "Chat con remitente sellado";
"onboard.chat.body" = "Cifrado de extremo a extremo en cada mensaje. El servidor no ve quién escribe a quién: la identidad de quien envía va sellada dentro del sobre, no en la cabecera.";
"onboard.nearby.kicker" = "CERCA";
"onboard.nearby.title" = "Encuentra gente de tu zona";
