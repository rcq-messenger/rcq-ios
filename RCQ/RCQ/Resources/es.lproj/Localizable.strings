"onboard.calls.kicker" = "VOZ Y VÍDEO";
"onboard.calls.title" = "Llamadas y grupos";
"onboard.calls.body" = "Llamadas de voz y vídeo por WebRTC, y grupos con toda la gente que añadas. Las notificaciones push te despiertan para las llamadas entrantes; el remitente sellado nos esconde el enrutado.";
"onboard.pets.kicker" = "MASCOTAS";
"onboard.pets.title" = "Consigue una mascota digital";
"onboard.pets.body" = "Abre cajas y colecciona mascotas animadas raras. Súbelas de nivel, regálalas, cámbialas. La misma mascota puede salir con rarezas distintas: ve a por la copia perfecta.";
"onboard.trade.kicker" = "INTERCAMBIO";
"onboard.trade.title" = "Intercambia en tiempo real";
"onboard.trade.body" = "Manda una oferta en un chat y la otra persona la ve al momento. Objetos, tokens y gemas, por cualquiera de los dos lados. \"Pedido\" vacío = regalo. \"Ofrecido\" vacío = petición de compra.";
"onboard.privacy.kicker" = "PRIVACIDAD";
