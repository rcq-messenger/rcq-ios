<?xml version="1.0" encoding="UTF-8"?>
<!--
  Privacy manifest for the main RCQ app bundle (`app.rcq.client`).
  Apple requires this for new submissions and binary updates since
  Spring 2024. Two halves:

    1. NSPrivacyCollectedDataTypes — the metadata RCQ actually sees
       on the server. End-to-end encrypted message content is NOT
       declared here because the server cannot read it (sealed sender
       + libsignal); same posture Signal / iMessage take.

    2. NSPrivacyAccessedAPITypes — Apple-required-reason APIs the
       binary calls. Reason codes are Apple's published shortcodes;
       see https://developer.apple.com/documentation/bundleresources/
       privacy_manifest_files/describing_use_of_required_reason_api .

  Update this whenever the data we collect changes. Changes in the
  underlying frameworks (e.g. libsignal pulling in a new API
  category) also need a re-audit.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- UIN — the numeric identifier the network assigns at
             signup. Linked to identity in the obvious way; no
             cross-app tracking. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Display name (nickname) and other free-text profile
             fields — status, first/last name when set. Optional;
             user controls. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeName</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- APNs push token — required by Apple to deliver pushes.
             Treated as a device ID for declaration purposes per
             Apple's data-type guidance. Not used for any tracking
             or analytics. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Approximate location, only when the user opts into People
             Nearby. Sent as a 5-6 character geohash bucket (≈5-20 km
             accuracy), never raw coordinates. Hood Chat used to share
             this declaration; it was deleted along with the island
             router behind it. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Voluntary user content: avatar (photo) + DOB. Avatar is
             a single profile image, not a stream of media. DOB is
             optional, set once. Both linked to the UIN, not used
             for anything beyond rendering the profile. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhotosOrVideos</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Crash diagnostics from Apple's own crash-reporting
             machinery. We don't ship a third-party crash SDK, but
             Apple's automatic on-device crash logs are part of the
             OS surface and Apple guidance is to declare them when
             the app receives them via TestFlight / App Store
             Connect. Not linked to user identity. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCrashData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults — used pervasively via @AppStorage for
             theme / sound / privacy-policy / language preferences,
             AND through the App Group container shared with the
             Notification Service Extension. Two reason codes
             reflect both surfaces. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
                <string>AC6B.1</string>
            </array>
        </dict>

        <!-- File timestamps — read via FileManager + URLSession
             cache plumbing to decide whether locally-cached media
             needs a re-fetch. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>3B52.1</string>
            </array>
        </dict>

        <!-- System boot time — touched by ProcessInfo.systemUptime
             and by libsignal's internal monotonic-clock usage when
             timestamping protocol events. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>

        <!-- Disk space — checked before writing downloaded media
             attachments so the app can fail loudly instead of
             silently filling up the user's device. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
