<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Communication Notifications: lets the app and the notification service
	     present a message as coming from a PERSON (INSendMessageIntent), with
	     their name and picture, instead of the app icon.
	     ⚠⚠ The App ID must have this capability enabled in the developer
	     portal, otherwise signing fails with a provisioning-profile mismatch
	     and the build will not upload. -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:rcq.app</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.rcq.shared</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.rcq.shared</string>
	</array>
</dict>
</plist>
