/* Тексты пушей, рендерятся NSE по полю `notif_kind` от бэкенда. */

"push.contact_request.body" = "хочет добавить вас в контакты";
"push.contact_response_accepted.body" = "принял вашу заявку в контакты";
/* Сообщение с другого острова от того, кто не принят в контакты: приложение
   кладёт его в заявки, поэтому пуш говорит об этом, а нажатие открывает заявки.
   Без текста и без имени (их номер здесь может принадлежать другому человеку). */
"push.message_request.body" = "Новая заявка на переписку";
"push.trade_received.gift.body" = "прислал вам подарок";
"push.trade_received.offer.body" = "прислал предложение обмена";
"push.uin_auction_outbid.title" = "Аукцион UIN";
"push.uin_auction_outbid.body" = "Вашу ставку перебили. Загляните в аукцион.";
/* Фолбэк, когда NSE не смог расшифровать групповой пуш (локализованный текст,
   в заголовке будет название группы). */
"push.group_message.body" = "Новое сообщение";
/* Показывается вместо отправителя и текста, когда приложение закрыто PIN-кодом
   или открыт декой-сеанс. NSE живёт в отдельном процессе и не видит состояние
   замка, поэтому читает флаг из App Group, который пишет приложение. */
"push.quiet.title" = "RCQ";
"push.quiet.body" = "Новое сообщение";
/* Текст пуша из чата, закрытого PIN-кодом (#1045). В заголовке остаётся, кто
   написал; сами слова остаются за PIN-кодом. */
"push.locked_chat.body" = "Новое сообщение";
